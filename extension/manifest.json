{
  "manifest_version": 2,
  "name": "__MSG_extensionName__",
  "version": "0.4.1",
  "description": "__MSG_extensionDescription__",
  "author": "essia",
  "browser_specific_settings": {
    "gecko": {
      "id": "heron@essia",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "experiment_apis": {
    "heron": {
      "schema": "api/schema.json",
      "parent": {
        "scopes": [
          "addon_parent"
        ],
        "paths": [
          [
            "heron"
          ]
        ],
        "script": "api/implementation.js"
      }
    }
  },
  "permissions": [
    "messagesModify",
    "storage"
  ],
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": false
  },
  "default_locale": "fr"
}
